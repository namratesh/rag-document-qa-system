# Copy to .env and fill in your key. .env is gitignored.

# Required: OpenRouter API key, used for both chat completions and
# embeddings (OpenRouter exposes an OpenAI-compatible API for both).
# Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=


# Optional overrides (sensible defaults are baked in):
# CHAT_MODEL_NAME=openai/gpt-4o-mini
# EMBEDDING_MODEL_NAME=nvidia/nemotron-3-embed-1b:free
